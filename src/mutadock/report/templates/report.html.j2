<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --page: #f9f9f7;
    --surface: #fcfcfb;
    --ink: #0b0b0b;
    --ink-2: #52514e;
    --muted: #898781;
    --hairline: rgba(11, 11, 11, 0.10);
    --accent: #2a78d6;
    --stabilizing: #2a78d6;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      Helvetica, Arial, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }
  a { color: var(--accent); }
  h1 { font-size: 26px; margin: 0 0 4px; letter-spacing: -0.01em; }
  h2 {
    font-size: 18px;
    margin: 40px 0 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--hairline);
    letter-spacing: -0.005em;
  }
  .subtle { color: var(--ink-2); font-size: 13.5px; }
  .muted { color: var(--muted); }
  .note {
    color: var(--ink-2);
    font-size: 12.5px;
    line-height: 1.5;
    margin: -4px 0 18px;
    max-width: 70ch;
  }
  .sd { color: var(--muted); font-size: 12px; }
  .warn {
    color: #7a2e00;
    background: #fff3e0;
    border: 1px solid #ffb74d;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    line-height: 1.5;
    margin: 0 0 14px;
    max-width: 70ch;
  }
  @media (prefers-color-scheme: dark) {
    .warn { color: #ffcc80; background: #3a2a12; border-color: #a86a2a; }
  }

  header.report-head {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 24px 26px;
  }
  header.report-head .meta-line { margin-top: 8px; }
  header.report-head .meta-line span { margin-right: 18px; }

  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 22px;
  }
  .tile {
    flex: 1 1 170px;
    min-width: 150px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 16px 18px;
  }
  .tile .tile-label {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tile .tile-value {
    font-size: 30px;
    font-weight: 650;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .tile .tile-sub {
    font-size: 12.5px;
    color: var(--ink-2);
    margin-top: 2px;
    word-break: break-word;
  }

  figure.plot {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 14px;
  }
  figure.plot img { display: block; width: 100%; max-width: 100%; height: auto; }

  .table-wrap {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    margin-top: 16px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  th, td {
    text-align: left;
    padding: 9px 14px;
    border-bottom: 1px solid var(--hairline);
    white-space: nowrap;
  }
  thead th {
    color: var(--muted);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  tbody tr:last-child td { border-bottom: none; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

  .viewer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
    align-items: start;
  }
  @media (max-width: 720px) {
    .viewer-grid { grid-template-columns: 1fr; }
  }
  #md-viewport {
    width: 100%;
    height: 480px;
    position: relative;
    background: #fff;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
  }
  .viewer-caption { margin-top: 8px; font-size: 12.5px; color: var(--ink-2); }

  footer.report-foot {
    margin-top: 56px;
    padding-top: 18px;
    border-top: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 13px;
  }

  @media print {
    body { background: #fff; }
    .container { max-width: none; padding: 0; }
    figure.plot, .tile, .table-wrap, header.report-head, #md-viewport {
      border-color: #ccc;
    }
    h2 { page-break-after: avoid; }
    figure.plot, .table-wrap { page-break-inside: avoid; }
  }
</style>
</head>
<body>
<div class="container">

  <!-- section: header -->
  <header class="report-head">
    <h1>{{ title }}</h1>
    <div class="subtle meta-line">
      {% if generated_at %}<span>Generated: {{ generated_at }}</span>{% endif %}
      {% if input_name %}<span>Input: <span class="mono">{{ input_name }}</span></span>{% endif %}
    </div>
  </header>

  <!-- section: tiles -->
  {% if tiles %}
  <div class="tiles">
    {% for tile in tiles %}
    <div class="tile">
      <div class="tile-label">{{ tile.label }}</div>
      <div class="tile-value">{{ tile.value }}</div>
      {% if tile.sub %}<div class="tile-sub">{{ tile.sub }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- section: distribution -->
  {% if fig_ddg %}
  <h2>ΔΔG distribution</h2>
  <figure class="plot">
    <img alt="Single-mutation ΔΔG distribution"
         src="data:image/png;base64,{{ fig_ddg|safe }}">
  </figure>
  {% endif %}
  {% if ddg_warning %}
  <p class="warn">⚠ {{ ddg_warning }}</p>
  {% endif %}
  {% if ddg_note %}
  <p class="note">{{ ddg_note }}</p>
  {% endif %}

  <!-- section: top-mutations -->
  {% if fig_top or single_rows %}
  <h2>Top stabilizing mutations</h2>
  {% if fig_top %}
  <figure class="plot">
    <img alt="Top stabilizing single mutations"
         src="data:image/png;base64,{{ fig_top|safe }}">
  </figure>
  {% endif %}
  {% if single_rows %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th class="num">#</th>
          <th>Mutation</th>
          <th>Chain</th>
          <th class="num">Position</th>
          <th>WT&rarr;Mut</th>
          <th class="num">ΔΔG (REU)</th>
          <th class="num">ΔΔG (kcal/mol)</th>
        </tr>
      </thead>
      <tbody>
        {% for r in single_rows %}
        <tr>
          <td class="num">{{ r.rank }}</td>
          <td class="mono">{{ r.label }}</td>
          <td>{{ r.chain }}</td>
          <td class="num">{{ r.position }}</td>
          <td>{{ r.wtAA }}&rarr;{{ r.prAA }}</td>
          <td class="num">{{ r.ddg }}{% if r.ddg_sd %} <span class="sd">{{ r.ddg_sd }}</span>{% endif %}</td>
          <td class="num">{{ r.ddg_kcal }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% endif %}

  <!-- section: double -->
  {% if double_rows %}
  <h2>Top double mutations</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th class="num">#</th>
          <th>Combination</th>
          <th class="num">ΔΔG (REU)</th>
          <th class="num">ΔΔG (kcal/mol)</th>
        </tr>
      </thead>
      <tbody>
        {% for r in double_rows %}
        <tr>
          <td class="num">{{ r.rank }}</td>
          <td class="mono">{{ r.combination }}</td>
          <td class="num">{{ r.ddg }}{% if r.ddg_sd %} <span class="sd">{{ r.ddg_sd }}</span>{% endif %}</td>
          <td class="num">{{ r.ddg_kcal }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <!-- section: docking -->
  {% if fig_affinity or docking_rows %}
  <h2>Docking affinity</h2>
  {% if fig_affinity %}
  <figure class="plot">
    <img alt="Docking affinity"
         src="data:image/png;base64,{{ fig_affinity|safe }}">
  </figure>
  {% endif %}
  {% if docking_rows %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th class="num">Affinity (kcal/mol)</th>
        </tr>
      </thead>
      <tbody>
        {% for r in docking_rows %}
        <tr>
          <td class="mono">{{ r.name }}</td>
          <td class="num">{{ r.affinity }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% endif %}

  <!-- section: viewer -->
  {% if has_structure %}
  <h2>Top mutant structure</h2>
  <div class="viewer-grid">
    <div>
      <div id="md-viewport"></div>
      <div class="viewer-caption">
        {% if mutation_caption %}Mutation <strong>{{ mutation_caption }}</strong> · {% endif %}drag to rotate · scroll to zoom
      </div>
    </div>
    {% if fig_structure %}
    <figure class="plot">
      <img alt="Cα backbone of the top mutant"
           src="data:image/png;base64,{{ fig_structure|safe }}">
    </figure>
    {% endif %}
  </div>
  {% endif %}

  <!-- section: provenance -->
  <h2>Provenance</h2>
  <div class="table-wrap">
    <table>
      <tbody>
        <tr><th>Generated at</th><td>{{ meta.generated_at }}</td></tr>
        {% if meta.input %}<tr><th>Input</th><td class="mono">{{ meta.input }}</td></tr>{% endif %}
        {% if meta.output_dir %}<tr><th>Output directory</th><td class="mono">{{ meta.output_dir }}</td></tr>{% endif %}
        <tr><th>PyRosetta</th><td>{{ meta.pyrosetta }}</td></tr>
        <tr><th>AutoDock Vina</th><td>{{ meta.vina }}</td></tr>
        {% if meta.files %}
        <tr><th>Source files</th><td class="mono">{{ meta.files|join(", ") }}</td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>

  <!-- section: footer -->
  <footer class="report-foot">
    Generated by <strong>MUTADOCK</strong> ·
    <a href="https://github.com/naisarg14/mutadock">github.com/naisarg14/mutadock</a>
  </footer>

</div>

{% if has_structure %}
<script>{{ ngl_js|safe }}</script>
<script>
(function () {
  function init() {
    var pdb = atob("{{ pdb_b64|safe }}");
    var stage = new NGL.Stage("md-viewport", { backgroundColor: "white" });
    stage.loadFile(new Blob([pdb], { type: "text/plain" }), { ext: "pdb" })
      .then(function (c) {
        c.addRepresentation("cartoon", { colorScheme: "chainid" });
        {% if ngl_sele %}
        c.addRepresentation("ball+stick", { sele: "{{ ngl_sele|safe }}" });
        {% endif %}
        c.autoView();
      });
    window.addEventListener("resize", function () { stage.handleResize(); });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
{% endif %}

</body>
</html>
